let currentPage = 1;
const PER_PAGE = 9;

function renderCategoriesGrid() {
    const allAds = JSON.parse(localStorage.getItem('ads')) || [];
    const container = document.getElementById('categoriesGrid');
    if (!container) return;
    
    container.innerHTML = categories.map(cat => {
