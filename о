/* ============================================
   СТИЛИ ДЛЯ ГЛАВНОЙ СТРАНИЦЫ (index.html)
   ============================================ */

/* Заголовок секции категорий */
.categories-title {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

/* Сетка категорий - 3 колонки */
.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 40px;
    width: 100%;
}

.category-chip {
    background: white;
    padding: 12px 15px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #e0e0e0;
}

.category-chip:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 12px rgba(0,0,0,0.1);
    border-color: #00aaff;
}

.category-chip-icon {
    font-size: 24px;
    width: 35px;
    text-align: center;
}

.category-chip-name {
    flex: 1;
    font-weight: 500;
    color: #333;
    font-size: 14px;
}

.category-chip-count {
    font-size: 12px;
    color: #999;
    background: #f5f5f5;
    padding: 4px 8px;
    border-radius: 20px;
}

/* Заголовок объявлений */
.ads-title {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    border-top: 2px solid #e0e0e0;
}

/* Сетка объявлений - 3 колонки */
.ads-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
    width: 100%;
}

/* Карточка объявления */
.ad-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    height: 100%;
    display: flex;
    flex-direction: column;
}

.ad-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.ad-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #f5f5f5;
    position: relative;
}

.ad-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}

.ad-card:hover .ad-image img {
    transform: scale(1.05);
}

/* Стикер категории на фото */
.ad-category-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(5px);
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    color: white;
    display: flex;
    align-items: center;
    gap: 5px;
    z-index: 1;
}

.ad-content {
    padding: 15px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.ad-title {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.ad-price {
    font-size: 18px;
    font-weight: 700;
    color: #00aaff;
    margin-bottom: 8px;
}

.ad-meta {
    display: flex;
    gap: 10px;
    font-size: 12px;
    color: #999;
    margin-top: auto;
    padding-top: 10px;
    flex-wrap: wrap;
}

/* Быстрые категории */
.quick-categories {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 25px;
    padding: 10px 0;
}

.quick-cat {
    padding: 8px 16px;
    background: white;
    border-radius: 20px;
    text-decoration: none;
    color: #555;
    font-size: 14px;
    transition: all 0.3s;
    border: 1px solid #e0e0e0;
}

.quick-cat:hover {
    background: #00aaff;
    color: white;
    border-color: #00aaff;
}

