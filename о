function getWordForCount(count) {
    if (count % 10 === 1 && count % 100 !== 11) return 'объявление';
    if (count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 10 || count % 100 >= 20)) return 'объявления';
    return 'объявлений';
